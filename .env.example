# OpenRouter (primary)
NALLY_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NALLY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NALLY_OPENROUTER_REASONING=false

# OpenCode Zen (fallback on OpenRouter 429 / outage)
# Get key at https://opencode.ai/zen
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=big-pickle
# OPENCODE_FALLBACK_MODELS=big-pickle,nemotron-3-super-free,nemotron-3-lightning-free,mimo-free

# Web search: Tavily primary, Brave fallback, DuckDuckGo last resort
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# External MCP servers (JSON array; disabled and unavailable by default).
# Each enabled server must explicitly allow-list tool names.
# Example stdio server:
# NALLY_MCP_SERVERS=[{"name":"local_docs","transport":"stdio","enabled":true,"command":"uvx","args":["some-mcp-server"],"allowed_tools":["search_docs"],"timeout_seconds":15}]
# Streamable HTTP servers use transport=streamable_http and url; optional headers are secrets.
NALLY_MCP_SERVERS=[]

# MCP provider credentials. Keep real values in the deployment's secret store.
GITHUB_MCP_TOKEN=
RENDER_API_KEY=
NEON_API_KEY=
TWELVE_DATA_API_KEY=
# For streamable_http headers use values like "Bearer ${GITHUB_MCP_TOKEN}" in NALLY_MCP_SERVERS.

# API auth
NALLY_ACCESS_TOKEN=change-me-long-secret

# Postgres memory (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Agent limits
NALLY_MAX_ITERATIONS=12
NALLY_MAX_TOOL_CALLS=20
NALLY_MAX_WALL_TIME=90
NALLY_CMD_TIMEOUT=30

NALLY_WORKSPACE=/tmp/nally-workspace
PORT=10000
NALLY_BASE_URL=https://your-service.onrender.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
