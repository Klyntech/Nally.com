# OpenRouter (required)
NALLY_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NALLY_MODEL=nvidia/nemotron-3.5-lightning:free
NALLY_OPENROUTER_REASONING=true

# API auth
NALLY_ACCESS_TOKEN=change-me-long-secret

# Postgres memory (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Agent limits
NALLY_MAX_ITERATIONS=12
NALLY_MAX_TOOL_CALLS=20
NALLY_MAX_WALL_TIME=90
NALLY_CMD_TIMEOUT=30

# Workspace for file_io / run_command (sandbox root)
NALLY_WORKSPACE=/tmp/nally-workspace

# Server
PORT=10000
# Public URL for Telegram webhook (Render)
NALLY_BASE_URL=https://your-service.onrender.com

# Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (only this user can chat). 0 = allow all (dev only)
TELEGRAM_USER_ID=0
# webhook (production) | polling (local) | off
TELEGRAM_MODE=webhook
# Optional: set the same value in setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=
