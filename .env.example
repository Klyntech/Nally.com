# OpenRouter (required)
NALLY_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NALLY_MODEL=nvidia/nemotron-3.5-lightning:free
# Reasoning slows replies; leave false unless you need it
NALLY_OPENROUTER_REASONING=false

# API auth
NALLY_ACCESS_TOKEN=change-me-long-secret

# Postgres memory (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Agent limits
NALLY_MAX_ITERATIONS=12
NALLY_MAX_TOOL_CALLS=20
NALLY_MAX_WALL_TIME=90
NALLY_CMD_TIMEOUT=30

# Workspace for file_io / run_command (sandbox root)
NALLY_WORKSPACE=/tmp/nally-workspace

# Server
PORT=10000
NALLY_BASE_URL=https://your-service.onrender.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
