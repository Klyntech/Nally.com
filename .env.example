# OpenRouter (primary)
NALLY_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NALLY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NALLY_OPENROUTER_REASONING=false

# OpenCode Zen (fallback on OpenRouter 429 / outage)
# Get key at https://opencode.ai/zen
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=big-pickle
# OPENCODE_FALLBACK_MODELS=big-pickle,nemotron-3-super-free,nemotron-3-lightning-free,mimo-free

# NVIDIA NIM (last-resort LLM fallback after OpenRouter and OpenCode Zen)
# Get an API key from NVIDIA API Catalog / build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# NVIDIA embeddings for the study library (RAG)
# Prefer a dedicated key; falls back to NVIDIA_API_KEY / NVIDIA_NIM_API_KEY
NVIDIA_EMBED_API_KEY=
NVIDIA_API_KEY=
NVIDIA_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
NVIDIA_EMBED_DIM=2048

# Web search: Tavily primary, Brave fallback, DuckDuckGo last resort
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# External MCP servers (JSON array; disabled and unavailable by default).
NALLY_MCP_SERVERS=[]

# MCP provider credentials. Keep real values in the deployment's secret store.
GITHUB_MCP_TOKEN=
RENDER_API_KEY=
NEON_API_KEY=
TWELVE_DATA_API_KEY=

# API auth
NALLY_ACCESS_TOKEN=change-me-long-secret

# Postgres memory + library (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Agent limits
NALLY_MAX_ITERATIONS=12
NALLY_MAX_TOOL_CALLS=20
NALLY_MAX_WALL_TIME=90
NALLY_CMD_TIMEOUT=30

NALLY_WORKSPACE=/tmp/nally-workspace
PORT=10000
NALLY_BASE_URL=https://your-service.onrender.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
